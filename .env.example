# Generated local values belong in .env (which is intentionally ignored).
WOLF_STATE_DIR=/home/USER/.local/share/docker-vm/wolf
WOLF_RUNTIME_DIR=/home/USER/.local/state/docker-vm/runtime
WOLF_RUN_UID=1000
WOLF_RUN_GID=1000
WOLF_RENDER_NODE=/dev/dri/renderD128

# Reference-host profile: Docker Engine 29 CDI. Use one form accepted by
# scripts/configure: nvidia.com/gpu=all, nvidia.com/gpu=<index>, or
# nvidia.com/gpu=GPU-<uuid>.
NVIDIA_CDI_DEVICE=nvidia.com/gpu=0
