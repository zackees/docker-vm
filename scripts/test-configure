#!/usr/bin/env bash
# The legacy Wolf writer was replaced by an informational, diskless entrypoint.
set -euo pipefail
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
python3 - "$repo/scripts/configure" <<'PY'
from pathlib import Path
import subprocess
import sys
import tempfile

with tempfile.TemporaryDirectory(prefix='docker-vm-configure-test-') as directory:
    root = Path(directory)
    (root / '.env').write_text('WOLF_STATE_DIR=$(touch should-not-exist)\n')
    (root / 'legacy-profile').write_text('preserve existing user data\n')
    before = {p.name: p.read_bytes() for p in root.iterdir()}
    for _ in range(2):
        result = subprocess.run(['bash', sys.argv[1]], cwd=root, check=True,
                                capture_output=True, text=True)
        assert 'No persistent desktop configuration is created.' in result.stdout
        assert {p.name: p.read_bytes() for p in root.iterdir()} == before
print('configure behavioral test: PASS')
PY
