#!/usr/bin/env python3
"""Print the desktop image's source fingerprint (the image tag).

SHA-256 over every regular file directly in images/desktop, in byte-sorted
name order, each fed as: name, NUL, contents, NUL. The tag is the first 16 hex
digits. The viewer computes the same value (session.rs `image_fingerprint`) to
decide whether its local image is current and which prebuilt image to pull;
CI publishes ghcr.io/zackees/docker-vm-desktop:<fingerprint>.
"""
from __future__ import annotations

import hashlib
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def fingerprint(directory: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted((p for p in directory.iterdir() if p.is_file()), key=lambda p: p.name.encode()):
        digest.update(path.name.encode() + b"\0" + path.read_bytes() + b"\0")
    return digest.hexdigest()[:16]


if __name__ == "__main__":
    print(fingerprint(Path(sys.argv[1]) if len(sys.argv) > 1 else ROOT / "images/desktop"))
