#!/usr/bin/env bash
# Read-only host readiness report. It deliberately does not start a container.
set -u -o pipefail
fail=0
pass() { printf 'PASS  %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*"; }
bad() { printf 'FAIL  %s\n' "$*"; fail=1; }
need() { command -v "$1" >/dev/null 2>&1 && pass "found $1" || bad "missing $1"; }
printf 'docker-vm preflight (read-only)\n'
printf 'host: %s %s (%s)\n' "$(uname -s)" "$(uname -r)" "$(uname -m)"
render_node="${WOLF_RENDER_NODE:-${GPU_RENDER_NODE:-/dev/dri/renderD128}}"
printf 'selected render node: %s (set WOLF_RENDER_NODE explicitly on multi-GPU hosts)\n' "$render_node"
need docker
if docker compose version >/dev/null 2>&1; then pass "found Docker Compose plugin"; else bad "Docker Compose v2 is unavailable"; fi
if docker info >/dev/null 2>&1; then pass "Docker daemon reachable (context $(docker context show 2>/dev/null || printf unknown))"; else bad "Docker daemon is not reachable by this user"; fi
if command -v nvidia-smi >/dev/null 2>&1; then
  if gpus="$(nvidia-smi --query-gpu=index,name,uuid,pci.bus_id,driver_version --format=csv,noheader 2>/dev/null)" && [[ -n "$gpus" ]]; then
    while IFS= read -r gpu; do pass "NVIDIA GPU: $gpu"; done <<< "$gpus"
  else
    bad "nvidia-smi exists but cannot query a GPU"
  fi
  if docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q nvidia; then pass "NVIDIA Docker runtime registered"; else warn "NVIDIA runtime is not listed. Docker 29 may use CDI, but GPU containers must be proven before streaming."; fi
  if find /var/run/cdi /etc/cdi -maxdepth 1 -type f -iname '*nvidia*' -print -quit 2>/dev/null | grep -q .; then pass "NVIDIA CDI specification present"; else warn "no NVIDIA CDI spec found; record a successful controller/worker GPU test before treating GPU access as ready"; fi
else
  warn "nvidia-smi not found; Intel/AMD users must verify render-node identity and encoder support in the selected image"
fi
for node in /sys/class/drm/renderD*/device; do
  [[ -e "$node" ]] || continue
  name="${node%/device}"; name="${name##*/}"
  vendor="$(cat "$node/vendor" 2>/dev/null || printf unknown)"
  pci="$(readlink -f "$node" 2>/dev/null | sed 's|.*/\(0000:[^/]*\).*|\1|')"
  driver="$(basename "$(readlink -f "$node/driver" 2>/dev/null || printf unknown)")"
  pass "DRM $name: vendor=$vendor pci=$pci driver=$driver"
done
if [[ -r "$render_node" ]]; then pass "current user can read selected node $render_node"; else warn "current user cannot read selected node $render_node (or it is absent)"; fi
if command -v moonlight >/dev/null 2>&1; then pass "native Moonlight client available: $(moonlight --version 2>&1 | head -1)"; else warn "Moonlight client not found; client decode and remote presentation remain unverified"; fi
printf '\nResult: '
if ((fail)); then printf 'NOT READY (hard prerequisites missing)\n'; exit 1; fi
printf 'HOST INSPECTED. Warnings are evidence gaps, not accelerated passes.\n'
