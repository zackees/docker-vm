#!/usr/bin/env bash
# Read-only diskless-session eligibility report.
set -u -o pipefail
strict=0; [[ ${1:-} == --strict ]] && strict=1
[[ $# -le 1 ]] || { echo "usage: $0 [--strict]" >&2; exit 2; }
bad=0
pass(){ printf 'PASS  %s\n' "$*"; }; warn(){ printf 'WARN  %s\n' "$*"; }; fail(){ printf 'FAIL  %s\n' "$*"; bad=1; }
mount_type() { findmnt -no FSTYPE -T "$1" 2>/dev/null || true; }
printf 'docker-vm strict preflight (read-only)\n'
[[ $(uname -s) == Linux ]] && pass 'native Linux host' || fail 'only native Linux is supported'
command -v docker >/dev/null && pass 'Docker client found' || fail 'Docker client missing'
if docker info >/dev/null 2>&1; then
  context=$(docker context show 2>/dev/null || true)
  [[ $context == default ]] && pass 'Docker daemon reachable on default context' || fail "Docker context '$context' is unsupported in strict mode"
  docker info --format '{{.OperatingSystem}}' 2>/dev/null | grep -qi 'docker desktop' && fail 'Docker Desktop/VM backing storage is unsupported' || pass 'not Docker Desktop'
else fail 'Docker daemon unreachable'; fi
runtime=${XDG_RUNTIME_DIR:-}
if [[ -n $runtime && -d $runtime ]]; then
  fs=$(mount_type "$runtime"); [[ $fs == tmpfs ]] && pass "XDG_RUNTIME_DIR is tmpfs: $runtime" || fail "XDG_RUNTIME_DIR is '$fs', not tmpfs: $runtime"
else fail 'XDG_RUNTIME_DIR is unavailable'; fi
if [[ -r /proc/swaps ]]; then
  swaps=$(awk 'NR>1 && $1 !~ /^\/dev\/zram/ {print $1}' /proc/swaps); [[ -z $swaps ]] && pass 'no non-zram active swap' || fail "active disk-backed swap: $swaps"
  zram=$(awk 'NR>1 && $1 ~ /^\/dev\/zram/ {print $1}' /proc/swaps); [[ -z $zram ]] && pass 'no zram swap' || warn "zram requires an administrator-confirmed no-writeback policy: $zram"
else fail 'cannot inspect /proc/swaps'; fi
if [[ -r /sys/power/state ]] && grep -qw disk /sys/power/state; then fail 'hibernation is available; disable it under the supported host policy'; else pass 'hibernation state is unavailable'; fi
core_pattern=$(cat /proc/sys/kernel/core_pattern 2>/dev/null || true)
[[ $core_pattern == '|'* || $core_pattern == /dev/null ]] && pass 'kernel core routing is not a direct disk file' || fail "kernel core pattern may write files: ${core_pattern:-unknown}"
if command -v systemctl >/dev/null 2>&1; then systemctl is-active --quiet systemd-coredump.socket && fail 'systemd-coredump is active' || pass 'systemd-coredump socket is inactive or unavailable'; fi
printf '\nResult: '
if ((bad)); then ((strict)) && printf 'REFUSED: strict diskless requirements are not met.\n' || printf 'INCOMPLETE: fix FAIL items before claiming disklessness.\n'; exit 1; fi
printf 'HOST ELIGIBLE: re-check before every privacy-sensitive session.\n'
