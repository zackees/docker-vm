#!/usr/bin/env bash
# Inspect a running ephemeral desktop without printing session secrets.
set -euo pipefail
container=${1:-}
[[ -n $container ]] || { echo "usage: $0 CONTAINER" >&2; exit 2; }
inspect=$(docker inspect "$container")
jq -e '
  .[0] as $c |
  $c.HostConfig.ReadonlyRootfs == true and
  $c.HostConfig.LogConfig.Type == "none" and
  $c.HostConfig.RestartPolicy.Name == "no" and
  (($c.HostConfig.PortBindings // {}) | length == 0) and
  (($c.HostConfig.Binds // []) | all(test("/run/session:ro$")))
' <<<"$inspect" >/dev/null || { echo "FAIL: container violates ephemeral desktop policy"; exit 1; }
echo "PASS: read-only root, no Docker logs/restart/published ports, and session bind is read-only"
