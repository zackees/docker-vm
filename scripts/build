#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
if [[ $# -ne 0 && ${1:-} != "--help" ]]; then
  echo "usage: scripts/build" >&2
  exit 2
fi
if [[ ${1:-} == "--help" ]]; then
  echo "Build the CPU-only ephemeral Chromium desktop image required by compose."
  exit 0
fi
docker build --pull -t docker-vm-desktop:local -f "$root/images/desktop/Dockerfile" "$root"
