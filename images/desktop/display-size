#!/usr/bin/env python3
"""Apply the viewer's requested framebuffer size on the GPU X server.

TigerVNC's Xorg module resizes through RandR outputs, and the headless NVIDIA
screen has none, so a client SetDesktopSize collapses the screen to 8x8. In
GPU mode the module ignores client resizes (AcceptSetDesktopSize 0) and the
viewer writes "WIDTHxHEIGHT" to /run/session/display-size instead; this sets
the screen size with `xrandr --fb`, which works without outputs. VNC clients
follow through the normal desktop-size update.
"""
from __future__ import annotations

import re
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

REQUEST = Path("/run/session/display-size")
SIZE = re.compile(r"^(\d{2,5})x(\d{2,5})$")
MAX_SIDE = 8192
MAX_PIXELS = 3840 * 2160


@dataclass(frozen=True)
class Size:
    width: int
    height: int

    @classmethod
    def parse(cls, text: str) -> Size | None:
        match = SIZE.match(text.strip())
        if not match:
            return None
        size = cls(int(match.group(1)), int(match.group(2)))
        valid = (32 <= size.width <= MAX_SIDE and 32 <= size.height <= MAX_SIDE
                 and size.width * size.height <= MAX_PIXELS)
        return size if valid else None


def apply(size: Size) -> None:
    result = subprocess.run(["xrandr", "--fb", f"{size.width}x{size.height}"], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"display-size: xrandr --fb {size.width}x{size.height} failed: {result.stderr.strip()}",
              file=sys.stderr, flush=True)


def main() -> int:
    applied: Size | None = None
    while True:
        try:
            requested = Size.parse(REQUEST.read_text())
        except OSError:
            requested = None
        if requested and requested != applied:
            apply(requested)
            applied = requested
        time.sleep(0.2)


if __name__ == "__main__":
    sys.exit(main())
