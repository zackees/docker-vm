#!/usr/bin/env python3
"""NVENC H.264 stream of the desktop for the private desktop viewer.

Started only in GPU mode (DESKTOP_VIDEO=nvenc). It first proves NVENC can open
a session; if not, it exits and the viewer keeps using VNC frames. Otherwise it
listens on TCP 5901 (container network only; never published) for one client
at a time and, while a client is connected, captures, encodes with nvh264enc
and sends each access unit:

    u32 payload length | u8 flags (bit 0 = keyframe) | u64 pts (us) | Annex-B AU

All big-endian. Input never comes through here: keyboard, pointer and resize
stay on RFB.

Capture (DESKTOP_CAPTURE):
  x11       ximagesrc on :0. The pipeline restarts with an IDR whenever the X
            framebuffer size changes.
  pipewire  The Wayland GPU desktop's output through xdg-desktop-portal-wlr.
            Frames stay on the GPU: PipeWire DMA-BUF -> GL -> NVENC. If the
            DMA-BUF path cannot negotiate, a system-memory pipeline is used.
            A pipeline error (e.g. the output was resized) restarts the pipeline.
"""
from __future__ import annotations

import os
import re
import socket
import struct
import sys
import threading
import time
from dataclasses import dataclass

import gi

gi.require_version("Gst", "1.0")
from gi.repository import GLib, Gst  # noqa: E402

HEADER = struct.Struct(">IBQ")
KEYFRAME = 1
SINK = ("h264parse config-interval=-1 ! video/x-h264,stream-format=byte-stream,alignment=au ! "
        "appsink name=sink emit-signals=true sync=false max-buffers=1 drop=false")
# Drops raw frames, never encoded ones, when the client or encoder falls
# behind, so every sent P-frame still decodes.
LEAKY = "queue leaky=downstream max-size-buffers=1 max-size-time=0 max-size-bytes=0"
# Capture retries before falling back (and again before giving up), and the
# frame count after which a pipeline counts as having worked.
# Written by wayland-session after each output resize/scale change.
OUTPUT_GENERATION = "/run/user/1000/output-generation"
RETRIES = 6
HEALTHY_FRAMES = 60
# A layout the portal does not offer never negotiates and never errors.
FIRST_FRAME_TIMEOUT_S = 3.0


@dataclass(frozen=True)
class Config:
    port: int = 5901
    cuda_device: int = 0
    fps: int = 60
    bitrate_kbps: int = 25000
    gop_frames: int = 120
    capture: str = "x11"

    @classmethod
    def from_env(cls) -> Config:
        return cls(cuda_device=int(os.environ.get("DESKTOP_VIDEO_CUDA_DEVICE", "0")),
                   capture=os.environ.get("DESKTOP_CAPTURE", "x11"))


@dataclass(frozen=True)
class PortalStream:
    """A screencast granted by xdg-desktop-portal: PipeWire remote fd, node,
    and the portal session that owns them."""
    fd: int
    node: int
    session: str


def log(message: str) -> None:
    print(f"video-stream: {message}", file=sys.stderr, flush=True)


def encoder(config: Config) -> str:
    return (f"nvh264enc preset=p1 tune=ultra-low-latency zerolatency=true "
            f"rc-mode=cbr bitrate={config.bitrate_kbps} gop-size={config.gop_frames} bframes=0")


def self_test(config: Config) -> bool:
    """NVENC can fail to open a session even when the element exists."""
    try:
        pipeline = Gst.parse_launch(
            f"videotestsrc num-buffers=3 ! video/x-raw,width=320,height=240,format=BGRx ! cudaupload ! "
            f"{encoder(config)} ! fakesink")
    except GLib.Error as error:
        log(f"encoder unavailable: {error.message}")
        return False
    pipeline.set_state(Gst.State.PLAYING)
    message = pipeline.get_bus().timed_pop_filtered(10 * Gst.SECOND, Gst.MessageType.EOS | Gst.MessageType.ERROR)
    pipeline.set_state(Gst.State.NULL)
    if message is None or message.type == Gst.MessageType.ERROR:
        log(f"encoder self-test failed: {message.parse_error()[0].message if message else 'timeout'}")
        return False
    return True


# Portal request/session tokens must be unique for the process lifetime: a
# reused request path is refused when the screencast is renewed.
TOKENS = iter(range(1_000_000_000))


def portal_stream() -> PortalStream:
    """CreateSession -> SelectSources(monitor) -> Start -> OpenPipeWireRemote.
    xdg-desktop-portal-wlr is configured to pick the headless output with no
    chooser, so this needs no user interaction."""
    import dbus
    import dbus.mainloop.glib

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    portal = bus.get_object("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop")
    screencast = dbus.Interface(portal, "org.freedesktop.portal.ScreenCast")
    sender = bus.get_unique_name()[1:].replace(".", "_")
    loop = GLib.MainLoop()
    responses: list[tuple[int, dict]] = []

    def request(method, *args, options: dict) -> dict:
        token = f"videostream{next(TOKENS)}"
        options["handle_token"] = token
        path = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
        match = bus.add_signal_receiver(lambda code, result: (responses.append((int(code), result)), loop.quit()),
                                        "Response", "org.freedesktop.portal.Request", path=path)
        method(*args, options)
        timeout = GLib.timeout_add_seconds(15, loop.quit)
        loop.run()
        GLib.source_remove(timeout) if responses else None
        match.remove()
        if not responses or responses[-1][0] != 0:
            raise RuntimeError(f"portal request {token} failed: {responses[-1][0] if responses else 'timeout'}")
        return responses.pop()[1]

    session = request(screencast.CreateSession,
                      options={"session_handle_token": f"videostreamsession{next(TOKENS)}"})["session_handle"]
    request(screencast.SelectSources, session, options={"types": dbus.UInt32(1), "multiple": False,
                                                        "cursor_mode": dbus.UInt32(1)})
    started = request(screencast.Start, session, "", options={})
    node = int(started["streams"][0][0])
    fd = screencast.OpenPipeWireRemote(session, dbus.Dictionary({}, signature="sv")).take()
    return PortalStream(fd=fd, node=node, session=str(session))


def close_portal_session(session: str) -> None:
    import dbus
    try:
        dbus.Interface(dbus.SessionBus().get_object("org.freedesktop.portal.Desktop", session),
                       "org.freedesktop.portal.Session").Close()
    except dbus.DBusException as error:
        log(f"closing portal session: {error.get_dbus_message()}")


def importable_modifiers() -> list[str]:
    """DMA-BUF formats glupload can import here, as `XR24:0x...` strings.

    The portal backend offers every modifier its renderer lists, but cannot
    allocate buffers for all of them (on NVIDIA some block-linear layouts fail),
    and pipewiresrc otherwise takes the first offered. Trying these one at a
    time finds a layout both ends accept. Linear (no modifier) comes last."""
    pipeline = Gst.parse_launch("videotestsrc num-buffers=1 ! glupload name=upload ! fakesink")
    pipeline.set_state(Gst.State.PAUSED)
    pipeline.get_state(5 * Gst.SECOND)
    caps = pipeline.get_by_name("upload").get_static_pad("sink").query_caps(None).to_string()
    pipeline.set_state(Gst.State.NULL)
    formats = sorted(set(re.findall(r"XR24:0x[0-9a-f]+", caps)))
    # Seen working on NVIDIA: the 0x...e08... family; try those first.
    formats.sort(key=lambda value: (":0x0300000000e08" not in value, value))
    return formats + ["XR24"]


class Capture:
    """Builds capture pipelines and finds a DMA-BUF layout that works."""

    def __init__(self, config: Config) -> None:
        self.config = config
        self.portal = self.acquire() if config.capture == "pipewire" else None
        self.dmabuf_ok = True
        self.modifiers = importable_modifiers() if self.portal else []
        self.modifier_index = 0
        # Set once a layout has streamed: failures after that (resizes) only
        # renew the screencast, they never move to another layout.
        self.proven = False
        if self.portal:
            log(f"portal screencast on PipeWire node {self.portal.node}; "
                f"{len(self.modifiers)} DMA-BUF layouts to try")

    @property
    def modifier(self) -> str:
        return self.modifiers[self.modifier_index]

    def next_modifier(self) -> bool:
        """Move to the next layout; False when all were tried."""
        if self.proven:
            return True
        if self.modifier_index + 1 >= len(self.modifiers):
            return False
        self.modifier_index += 1
        return True

    def renew(self) -> None:
        """A resized output can end the screencast (its PipeWire node goes
        away); ask the portal for a new one."""
        if not self.portal:
            return
        old = self.portal
        close_portal_session(old.session)
        # Keep the old stream until a new one exists, so a failed renewal
        # never leaves a closed fd behind.
        self.portal = self.acquire()
        os.close(old.fd)
        log(f"new portal screencast on PipeWire node {self.portal.node}")

    @staticmethod
    def acquire() -> PortalStream:
        # PipeWire/WirePlumber/portal start alongside this service.
        for attempt in range(10):
            try:
                return portal_stream()
            except Exception as error:  # noqa: BLE001 - retried, then reported
                log(f"portal not ready ({attempt + 1}/10): {error}")
                GLib.usleep(1_000_000)
        raise RuntimeError("no portal screencast")

    def description(self) -> str:
        config = self.config
        if not self.portal:
            return (f"ximagesrc display-name=:0 use-damage=false show-pointer=false ! "
                    f"video/x-raw,framerate={config.fps}/1 ! {LEAKY} ! cudaupload ! {encoder(config)} ! {SINK}")
        source = (f"pipewiresrc fd={os.dup(self.portal.fd)} target-object={self.portal.node} "
                  f"always-copy=false do-timestamp=true")
        if self.dmabuf_ok:
            # Compositor buffer -> EGLImage -> CUDA, never through the CPU,
            # pinned to one buffer layout (see importable_modifiers).
            # The BGRx alternative lets the parser link glupload (a lone
            # pinned DMA_DRM input leaves it no linkable output format); at
            # runtime the DMA-BUF entry wins whenever the portal offers it.
            caps = f"video/x-raw(memory:DMABuf),format=DMA_DRM,drm-format={self.modifier};video/x-raw,format=BGRx"
            return (f'{source} ! capsfilter name=capture caps="{caps}" ! '
                    f"glupload ! glcolorconvert ! "
                    f"video/x-raw(memory:GLMemory),format=NV12 ! {LEAKY} ! {encoder(config)} ! {SINK}")
        return (f"{source} ! video/x-raw ! {LEAKY} ! videoconvert ! video/x-raw,format=NV12 ! cudaupload ! "
                f"{encoder(config)} ! {SINK}")


class Stream:
    """One capture/encode pipeline feeding one connected client."""

    def __init__(self, description: str, client: socket.socket) -> None:
        self.client = client
        self.client_gone = threading.Event()
        self.pipeline_failed = threading.Event()
        self.frames = 0
        self.started_at = time.monotonic()
        self.pipeline = Gst.parse_launch(description)
        self.pipeline.get_by_name("sink").connect("new-sample", self.on_sample)
        bus = self.pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self.on_error)

    def on_sample(self, sink: Gst.Element) -> Gst.FlowReturn:
        buffer = sink.emit("pull-sample").get_buffer()
        ok, info = buffer.map(Gst.MapFlags.READ)
        if not ok:
            return Gst.FlowReturn.ERROR
        try:
            flags = 0 if buffer.has_flags(Gst.BufferFlags.DELTA_UNIT) else KEYFRAME
            pts = buffer.pts // 1000 if buffer.pts != Gst.CLOCK_TIME_NONE else 0
            self.client.sendall(HEADER.pack(len(info.data), flags, pts) + bytes(info.data))
            self.frames += 1
            if self.frames == 1:
                capture = self.pipeline.get_by_name("capture")
                caps = capture.get_static_pad("src").get_current_caps() if capture else None
                if caps:
                    log(f"capturing {caps.get_structure(0).get_string('drm-format') or caps.get_structure(0).get_string('format')}"
                        f" ({'DMA-BUF, zero-copy' if caps.get_features(0).contains('memory:DMABuf') else 'system memory'})")
        except OSError:
            self.client_gone.set()
            return Gst.FlowReturn.EOS
        finally:
            buffer.unmap(info)
        return Gst.FlowReturn.OK

    def on_error(self, _bus: Gst.Bus, message: Gst.Message) -> None:
        log(f"pipeline error: {message.parse_error()[0].message}")
        self.pipeline_failed.set()

    def start(self) -> None:
        self.pipeline.set_state(Gst.State.PLAYING)

    def stop(self) -> None:
        self.pipeline.set_state(Gst.State.NULL)


class Server:
    def __init__(self, config: Config, capture: Capture) -> None:
        self.config = config
        self.capture = capture
        self.client: socket.socket | None = None
        self.stream: Stream | None = None
        self.pending_restart = 0
        self.failures = 0
        self.output_generation = self.read_generation()

    @staticmethod
    def read_generation() -> str:
        try:
            with open(OUTPUT_GENERATION) as handle:
                return handle.read().strip()
        except OSError:
            return ""

    def output_changed(self) -> bool:
        generation = self.read_generation()
        changed = generation != self.output_generation
        self.output_generation = generation
        return changed

    def restart(self) -> bool:
        self.pending_restart = 0
        if self.stream:
            self.stream.stop()
            self.stream = None
        if self.client:
            try:
                self.stream = Stream(self.capture.description(), self.client)
            except GLib.Error as error:
                log(f"pipeline rebuild failed, retrying: {error.message}")
                self.schedule_restart()
                return False
            self.stream.start()
        return False

    def schedule_restart(self, delay_ms: int = 300) -> None:
        # Coalesce the burst of changes a resize produces.
        if self.pending_restart:
            GLib.source_remove(self.pending_restart)
        self.pending_restart = GLib.timeout_add(delay_ms, self.restart)

    def drop_client(self) -> None:
        if self.stream:
            self.stream.stop()
            self.stream = None
        if self.client:
            self.client.close()
            self.client = None

    def accept(self, listener: socket.socket, _condition: GLib.IOCondition) -> bool:
        client, _ = listener.accept()
        client.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        self.drop_client()  # One viewer: the newest connection wins.
        self.client = client
        self.restart()
        return True

    def watchdog(self) -> bool:
        if self.capture.portal and self.output_changed():
            # The resized output silently stalls the old screencast, whether
            # or not a viewer is connected yet.
            log("output changed; renewing the screencast")
            try:
                self.capture.renew()
            except RuntimeError as error:
                log(f"cannot renew screencast: {error}")
            if self.client:
                self.schedule_restart(100)
            return True
        stream = self.stream
        if stream and stream.frames == 0 and time.monotonic() - stream.started_at > FIRST_FRAME_TIMEOUT_S:
            stream.pipeline_failed.set()
        if stream and stream.client_gone.is_set():
            self.drop_client()
        elif stream and stream.pipeline_failed.is_set() and not self.pending_restart:
            if stream.frames >= HEALTHY_FRAMES:
                self.failures = 0  # it ran; this is a new problem (e.g. a resize)
                self.capture.proven = self.capture.proven or self.capture.dmabuf_ok
            self.failures += 1
            if self.capture.portal:
                # A layout the portal cannot allocate fails before any frame:
                # try the next one; only when none works use system memory.
                if self.capture.dmabuf_ok and stream.frames < HEALTHY_FRAMES:
                    if self.capture.proven:
                        pass  # keep the layout that worked; just renew
                    elif self.capture.next_modifier():
                        log(f"DMA-BUF layout failed; trying {self.capture.modifier}")
                    else:
                        log("no DMA-BUF layout worked; using system-memory capture")
                        self.capture.dmabuf_ok = False
                        self.failures = 0
                elif self.failures >= RETRIES:
                    log("capture keeps failing; video stream stopped")
                    self.drop_client()
                    return True
                try:
                    self.capture.renew()
                except RuntimeError as error:
                    log(f"cannot renew screencast: {error}")
                self.output_changed()  # this renewal already covers a pending resize
            # A resized output renegotiates the stream; rebuild with an IDR.
            self.schedule_restart()
        return True

    def run(self) -> None:
        listener = socket.create_server(("0.0.0.0", self.config.port), backlog=1)
        GLib.io_add_watch(listener, GLib.IO_IN, self.accept)
        if not self.capture.portal:
            # A new X framebuffer size needs new caps and an IDR.
            gi.require_version("Gdk", "3.0")
            from gi.repository import Gdk
            Gdk.init([])
            Gdk.Screen.get_default().connect("size-changed", lambda *_: self.schedule_restart())
        GLib.timeout_add(250, self.watchdog)
        log(f"listening on {self.config.port} ({self.config.capture} capture)")
        GLib.MainLoop().run()


def main() -> int:
    config = Config.from_env()
    # nvh264enc always uses CUDA device 0 of what is visible; show CUDA only
    # the chosen GPU (index under CUDA_DEVICE_ORDER=PCI_BUS_ID).
    os.environ["CUDA_VISIBLE_DEVICES"] = str(config.cuda_device)
    Gst.init(None)
    if not self_test(config):
        return 0
    try:
        capture = Capture(config)
    except Exception as error:  # noqa: BLE001 - no capture means no video service
        log(f"capture unavailable: {type(error).__name__}: {error}")
        return 0
    Server(config, capture).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
